server {
    listen 80;
    server_name TEMPLATE_DOMAIN www.TEMPLATE_DOMAIN;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name TEMPLATE_DOMAIN www.TEMPLATE_DOMAIN;
    root /var/www/TEMPLATE_DOMAIN;
    ssl_certificate /etc/letsencrypt/live/TEMPLATE_DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/TEMPLATE_DOMAIN/privkey.pem;
    # ... rest of config
}
